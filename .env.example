APP_NAME="HMS Sync"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is required (ILIKE search, pg_trgm indexes).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hms_sync
DB_USERNAME=postgres
DB_PASSWORD=

# Production: redis for cache, session and queue (see docs/DEPLOYMENT.md).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# Set to true once the app is served over HTTPS.
SESSION_SECURE_COOKIE=false

# reverb = realtime front desk; log = disabled
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where PHP publishes events (internal address of the Reverb server)
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# What the browser connects to (public address behind the proxy)
VITE_REVERB_HOST=
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# phpredis (extension) in production; predis works without the extension.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Content Security Policy. Permissive by default so the theme's inline scripts
# and CDN plugins keep working. Add origins (space separated) if you integrate
# a third-party widget; set CSP_ENABLED=false only as a last resort.
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_CSP_UPGRADE_INSECURE=false
SECURITY_CSP_EXTRA_HOSTS=

# Turn on only once HTTPS is confirmed working in production - browsers
# remember this header for a year.
SECURITY_HSTS=false

# Rejects URLs carrying obvious SQLi / traversal / XSS signatures.
SECURITY_BLOCK_SUSPICIOUS=true

# Requests per minute.
RATE_LIMIT_WEB=300
RATE_LIMIT_LOGIN=5
RATE_LIMIT_PASSWORD=5
RATE_LIMIT_WRITE=60
RATE_LIMIT_API=60

# CORS applies ONLY to api/* and broadcasting/auth - never to pages or assets.
# Comma separated; defaults to APP_URL when empty.
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_PATTERNS=

# Set to your proxy IPs (or "*") ONLY when running behind nginx/Cloudflare.
# Leave empty otherwise, or clients can spoof their IP via X-Forwarded-For.
TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Hotel management (config/hms.php)
# ---------------------------------------------------------------------------
# Tripay payment gateway. Leave TRIPAY_API_KEY empty to hide online payment
# (guests then use manual bank transfer). Register the callback URL
# {APP_URL}/payment/tripay/callback in the Tripay merchant dashboard.
TRIPAY_MODE=sandbox
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_EXPIRY_MINUTES=120

# Smart-lock driver: "log" (no hardware) until a vendor driver is added.
DOOR_LOCK_DRIVER=log  # log | ttlock

# Paid/confirmed guests who have not arrived are marked no-show at this time
# on the day after their check-in date.
HMS_NO_SHOW_CUTOFF=02:00

# ---------------------------------------------------------------------------
# Backups (spatie/laravel-backup, config/backup.php)
# ---------------------------------------------------------------------------
BACKUP_DISK=local
BACKUP_NOTIFY_EMAIL=
BACKUP_ARCHIVE_PASSWORD=

# First Superadmin created by `php artisan db:seed` (password random if empty).
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=

# TTLock smart locks (DOOR_LOCK_DRIVER=ttlock). Each room stores its lockId.
TTLOCK_BASE_URL=https://euapi.ttlock.com
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_USERNAME=
TTLOCK_PASSWORD=
